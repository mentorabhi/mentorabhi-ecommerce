#!/usr/bin/env sh
set -eu
repo_root=$(CDPATH= cd -- "$(dirname -- "$0")/../.." && pwd)
if [ ! -x "$repo_root/.venv/bin/python" ]; then
    printf '%s\n' 'Create the repository .venv with a compatible Python interpreter first.' >&2
    exit 1
fi
exec "$repo_root/.venv/bin/python" "$repo_root/devops/scripts/manage.py" "$@"
