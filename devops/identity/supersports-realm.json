{
  "realm": "supersports",
  "enabled": true,
  "displayName": "SuperSports Local",
  "sslRequired": "none",
  "registrationAllowed": false,
  "resetPasswordAllowed": false,
  "loginWithEmailAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "customer"
      },
      {
        "name": "catalog-admin"
      },
      {
        "name": "inventory-operator"
      },
      {
        "name": "platform-admin"
      }
    ]
  },
  "clients": [
    {
      "clientId": "supersports-cli",
      "name": "Synthetic local test CLI only",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ],
      "protocolMappers": [
        {
          "name": "supersports-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "supersports-api",
            "id.token.claim": "false",
            "access.token.claim": "true",
            "introspection.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "supersports-other-cli",
      "name": "Negative audience test fixture",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "defaultClientScopes": [
        "basic",
        "profile",
        "email",
        "roles"
      ]
    },
    {
      "clientId": "supersports-web",
      "name": "Future storefront PKCE client",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "supersports-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.custom.audience": "supersports-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
  "users": [
    {
      "username": "customer",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Synthetic",
      "lastName": "Customer",
      "email": "customer@supersports.local",
      "realmRoles": [
        "customer"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_CUSTOMER_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "platform-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Synthetic",
      "lastName": "Platform",
      "email": "platform-admin@supersports.local",
      "realmRoles": [
        "platform-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_PLATFORM_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "catalog-admin",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Synthetic",
      "lastName": "Catalog",
      "email": "catalog-admin@supersports.local",
      "realmRoles": [
        "catalog-admin"
      ],
      "credentials": [
        {
          "type": "password",
          "value": "${DEMO_CATALOG_ADMIN_PASSWORD}",
          "temporary": false
        }
      ]
    },
    {
      "username": "inventory-operator",
      "enabled": true,
      "emailVerified": true,
      "firstName": "Synthetic",
      "lastName": "Inventory",
      "email": "inventory-operator@supersports.local",
      "realmRoles": ["inventory-operator"],
      "credentials": [{"type": "password", "value": "${DEMO_INVENTORY_OPERATOR_PASSWORD}", "temporary": false}]
    }
  ]
}
